{
  "siteUrl": "https://play.mesisi.net",
  "branch": "pipeline-inbox",
  "maxAttempts": 3,
  "timeoutMinutes": 25,
  "agents": {
    "codex": { "cmd": "codex", "args": ["exec", "-m", "gpt-6.2-sol", "--sandbox", "read-only", "-o", "{out}", "{instruction}"] },
    "codexBuild": { "cmd": "codex", "args": ["exec", "-m", "gpt-6.2-sol", "--sandbox", "workspace-write", "-o", "{out}", "{instruction}"] },
    "claude": { "cmd": "claude", "args": ["-p", "{instruction}", "--model", "sonnet", "--effort", "medium", "--tools", "Read,Glob,Grep,WebSearch,WebFetch", "--allowedTools", "Read,Glob,Grep,WebSearch,WebFetch", "--strict-mcp-config", "--no-session-persistence"] }
  }
}
