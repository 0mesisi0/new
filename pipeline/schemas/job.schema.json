{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline job",
  "type": "object",
  "required": ["id", "site", "status", "stage", "attempts", "maxAttempts", "history"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
    "site": { "enum": ["play", "calc"] },
    "slug": { "type": ["string", "null"] },
    "status": { "enum": ["queued", "running", "review", "approved", "failed", "published"] },
    "stage": { "enum": ["research", "idea", "design", "build", "review", "publish", "feedback"] },
    "attempts": { "type": "integer", "minimum": 0 },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "owner": { "type": "string", "description": "Agent that holds the job now, e.g. claude, codex, gemini, human" },
    "pr": { "type": ["integer", "null"] },
    "artifacts": { "type": "object", "additionalProperties": { "type": "string" } },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "stage", "status", "by"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "stage": { "type": "string" },
          "status": { "type": "string" },
          "by": { "type": "string" },
          "note": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
